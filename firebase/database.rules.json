{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid', 'email', 'name'])",
        "privacy": {
          "email": {
            ".validate": "newData.isString()"
          },
          "about": {
            ".validate": "newData.isString()"
          },
          "lastSeen": {
            ".validate": "newData.isString()"
          }
        }
      }
    },

    "usernames": {
      "$username": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.isString() && newData.val() === auth.uid)"
      }
    },

    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() === true",
        ".write": "auth != null && (data.child('members').child(auth.uid).val() === true || newData.child('members').child(auth.uid).val() === true)",
        "members": {
          "$uid": {
            ".validate": "newData.isBoolean()"
          }
        },
        "memberNames": {
          "$uid": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          }
        },
        "memberPhotos": {
          "$uid": {
            ".validate": "newData.isString()"
          }
        },
        "admins": {
          "$uid": {
            ".validate": "newData.isBoolean()"
          }
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "link": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 20 && (data.val() === newData.val() || root.child('chats').child($chatId).child('ownerId').val() === auth.uid || root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true))"
        },
        "photoUrl": {
          ".validate": "newData.isString()"
        },
        "readAt": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
            ".validate": "newData.isNumber()"
          }
        },
        "lastMessage": {
          ".validate": "newData.hasChildren(['text', 'senderId', 'type', 'createdAt'])"
        },
        "reactions": {
          "$messageId": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isString() && newData.val().length <= 8"
            }
          }
        }
      }
    },

    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
        ".indexOn": ["createdAt"],
        "$messageId": {
          ".write": "auth != null && (data.child('senderId').val() === auth.uid || root.child('chats').child($chatId).child('ownerId').val() === auth.uid || root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.exists() == false || newData.hasChildren(['senderId', 'type', 'createdAt'])"
        }
      }
    },

    "typing": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null"
        }
      }
    },

    "groupLinks": {
      "$link": {
        ".read": "auth != null",
        ".write": "auth != null && ((data.exists() && (root.child('chats').child(data.val()).child('ownerId').val() === auth.uid || root.child('chats').child(data.val()).child('admins').child(auth.uid).val() === true)) || (newData.exists() && (root.child('chats').child(newData.val()).child('ownerId').val() === auth.uid || root.child('chats').child(newData.val()).child('admins').child(auth.uid).val() === true)))",
        ".validate": "!newData.exists() || newData.isString()"
      }
    },

    "groupInvites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('chats').child($chatId).child('ownerId').val() === auth.uid || root.child('chats').child($chatId).child('admins').child(auth.uid).val() === true)",
          ".validate": "!newData.exists() || newData.hasChildren(['chatId', 'title', 'link', 'fromUid', 'createdAt'])"
        }
      }
    }
  }
}
